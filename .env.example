# RAGPlan local/demo configuration only.
# Never reuse this sample password outside an isolated development machine.
RAGPLAN_SERVER__HOST=127.0.0.1
RAGPLAN_SERVER__PORT=8000
RAGPLAN_VECTOR__URL=http://127.0.0.1:6333
RAGPLAN_GRAPH__URI=bolt://127.0.0.1:7687
RAGPLAN_GRAPH__USER=neo4j
RAGPLAN_GRAPH__PASSWORD=ragplan-demo-change-me
RAGPLAN_LOGGING__MODE=redacted

# Optional Stage 3 API bootstrap. Set all four runtime values together; otherwise
# /v1/search remains explicitly NOT_READY while /health stays healthy.
# Container paths use the read-only mounts configured in docker-compose.yml.
RAGPLAN_STAGE3_MODELS_HOST_DIR=./models
RAGPLAN_STAGE3_ARTIFACTS_HOST_DIR=./artifacts
# RAGPLAN_STAGE3_MODEL_SNAPSHOT=/opt/ragplan/models/minilm/models--sentence-transformers--all-MiniLM-L6-v2/snapshots/b8903db39f65d93ae28d49a37c4f3fa90c5f94e0
# RAGPLAN_STAGE3_VECTOR_STAGE_MANIFEST=/opt/ragplan/artifacts/sample-stage3-vector.json
# RAGPLAN_STAGE3_QDRANT_URL=http://qdrant:6333
# RAGPLAN_STAGE3_QDRANT_COLLECTION_PREFIX=ragplan_chunks

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragplan-demo-change-me
RAGPLAN_API_PORT=8000
